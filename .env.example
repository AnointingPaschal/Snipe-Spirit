# ===========================
# Meteora DLMM Sniper Bot
# ===========================

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Your wallet private key (base58 string or JSON array)
SOLANA_PRIVATE_KEY=

# AI Brain (OPTIONAL — built-in smart brain works without this!)
# If you want Claude AI decisions instead of the rule-based brain,
# get an API key from https://openrouter.ai
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Trading
TRADE_AMOUNT_USD=1
MAX_CONCURRENT_POSITIONS=5
MIN_TVL_USD=3000
MIN_VOLUME_24H_USD=5000
SLIPPAGE_BPS=300

# Start with DRY_RUN=true to paper trade first!
DRY_RUN=true

# Exit Strategy
STOP_LOSS_PCT=-15
TAKE_PROFIT_PCT=40

# Loop
POLL_INTERVAL_MS=15000
LOG_LEVEL=info
